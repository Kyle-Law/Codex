{
  "manifest_version": 3,
  "name": "Article Insight Highlighter",
  "description": "Highlight article text with notes, videos, and references.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Article Insight Highlighter",
    "default_popup": "popup.html"
  }
}
